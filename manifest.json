{
  "manifest_version": 3,
  "name": "match13 Extension",
  "version": "1.0.1",
  "description": "A compact Firefox dashboard for Match 13 team statistics and match forecasts.",
  "homepage_url": "https://github.com/CJBrandi/match13-extension",
  "browser_specific_settings": {
    "gecko": {
      "id": "match13-extension@cjbrandi",
      "strict_min_version": "112.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://actions.match13.com/*"
  ],
  "icons": {
    "192": "assets/icon.png"
  },
  "action": {
    "default_title": "match13",
    "default_icon": {
      "192": "assets/icon.png"
    },
    "default_popup": "popup.html"
  }
}
